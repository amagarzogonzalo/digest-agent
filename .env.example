# Copy this file to `.env` and fill in your values. `.env` is git-ignored —
# never commit it. Environment variables override values in `.env`.

# === GitHub (required) ===
# Personal access token with repo scope.
GITHUB_TOKEN=ghp_xxx
# Comma-separated list of repos, "owner/repo" format.
GITHUB_REPOS=owner/repo,owner/repo2

# === LLM providers (at least one key required) ===
# Providers are tried in capability order until a model works:
#   1. Gemini (AI Studio)  - strongest, detailed
#   2. OpenRouter          - decent, varied (free catalog)
#   3. Groq                - reliable fallback
#   4. Mistral             - fallback
# Only providers with a key set are used. Set several for resilience.
# Candidate models are all free.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=AIza_xxx  # or the "AQ." AI-Studio key format

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-xxx
# Alias accepted for OPENROUTER_API_KEY:
# OPEN_ROUTER_API_KEY=sk-or-xxx

# --- Groq ---
GROQ_API_KEY=gsk_xxx

# --- Mistral ---
MISTRAL_API_KEY=xxx

# === Email / notifier (required to send) ===
# Choose the notifier: smtp (default) | resend
NOTIFIER=smtp

# --- SMTP (used when NOTIFIER=smtp) ---
# Gmail (defaults to smtp.gmail.com:465):
GMAIL_ADDRESS=user@gmail.com
GMAIL_APP_PASSWORD=xxx

# Generic SMTP (Ethereal, etc.) — uncomment to override Gmail host:
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=whatever@ethereal.email
# SMTP_PASSWORD=xxx
# SMTP_STARTTLS=true

# --- Resend (used when NOTIFIER=resend) ---
# Key from https://resend.com/api-keys (emailed to you; starts with re_).
# RESEND_API_KEY=re_xxx
# From address. If blank, Resend uses onboarding@resend.dev (only works with
# the email you signed up with). Once you verify a domain you can send from it.
# RESEND_FROM=onboarding@resend.dev

# Where to send the digest. Defaults to GMAIL_ADDRESS / SMTP_USER if empty.
RECIPIENT_EMAIL=amagarzo@gmail.com

# === Optional ===
# Days of activity to look back (default 1).
LOOKBACK_DAYS=1
# Directory for generated PDFs (default: system temp dir).
# DIGEST_OUTPUT_DIR=./digests